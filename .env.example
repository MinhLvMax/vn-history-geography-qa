# === Cấu hình API Key cho các nhà cung cấp LLM Cloud (Tùy chọn theo provider sử dụng) ===
OPENAI_API_KEY=sk-proj-...
GROQ_API_KEY=gsk_...

# === Cấu hình Ollama Local / Remote (Mặc định: http://localhost:11434) ===
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_API_KEY=

# === Cấu hình Cơ sở dữ liệu Đồ thị Neo4j ===
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# === Cấu hình Cơ sở dữ liệu Vector Qdrant ===
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=vnhis

# === Cấu hình Cơ sở dữ liệu PostgreSQL (Lưu trữ Users, Sessions, Conversations, Models) ===
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vnhisgeoqa
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# === Tài khoản Quản trị viên khởi tạo mặc định ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password

# === Cấu hình pgAdmin (Dùng trong docker-compose.yaml) ===
PGADMIN_EMAIL=pgadmin@example.com
PGADMIN_PASSWORD=your_pgadmin_password
